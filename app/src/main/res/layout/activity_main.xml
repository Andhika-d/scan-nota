<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_hero" android:paddingHorizontal="12dp" android:paddingTop="8dp" android:paddingBottom="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Scan Nota" android:layout_weight="1" android:paddingStart="8dp" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnMenu" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Menu" app:icon="@drawable/ic_more" app:iconTint="@color/white" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<com.google.android.material.button.MaterialButton android:id="@+id/btnPrev" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Bulan sebelumnya" app:icon="@drawable/ic_left" app:iconTint="@color/white" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
<TextView android:id="@+id/txtMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/white_soft" android:textSize="14sp"/>
<TextView android:id="@+id/txtTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 0" android:textColor="@color/white" android:textSize="34sp" android:textStyle="bold"/>
<TextView android:id="@+id/txtCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/white_soft" android:textSize="13sp"/>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnNext" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Bulan berikutnya" app:icon="@drawable/ic_right" app:iconTint="@color/white" />
</LinearLayout>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<androidx.core.widget.NestedScrollView android:id="@+id/pageHistory" android:layout_width="match_parent" android:layout_height="match_parent" >
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="16dp">
<LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
<LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="40dp" android:visibility="gone">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Belum ada nota di bulan ini" style="@style/Heading"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Foto nota belanja, datanya terisi otomatis." style="@style/Soft" android:layout_marginTop="4dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnSample" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Muat data contoh" />
</LinearLayout>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
<androidx.core.widget.NestedScrollView android:id="@+id/pageSummary" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="16dp">
<com.google.android.material.card.MaterialCardView style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pengeluaran 6 bulan" style="@style/Heading"/>
<TextView android:id="@+id/txtCompare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" style="@style/Soft"/>
<com.example.scannota.BarChartView android:id="@+id/chart" android:layout_width="match_parent" android:layout_height="170dp" android:layout_marginTop="12dp" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView><com.google.android.material.card.MaterialCardView style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" >
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rata-rata per nota" style="@style/Soft"/>
<TextView android:id="@+id/txtAverage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 0" style="@style/Heading"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nota terbesar" style="@style/Soft"/>
<TextView android:id="@+id/txtBiggest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 0" style="@style/Heading"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>
</com.google.android.material.card.MaterialCardView><com.google.android.material.card.MaterialCardView style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" >
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Belanja per toko" style="@style/Heading"/>
<TextView android:id="@+id/rankEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Belum ada data di bulan ini" style="@style/Soft" android:layout_marginTop="8dp"/>
<LinearLayout android:id="@+id/ranking" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
</FrameLayout>
<LinearLayout android:id="@+id/actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:paddingVertical="8dp">
<com.google.android.material.button.MaterialButton android:id="@+id/btnCamera" style="@style/Widget.Material3.Button.Icon" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:paddingHorizontal="8dp" android:text="Foto Nota" app:icon="@drawable/ic_camera" app:iconGravity="textStart" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnGallery" style="@style/Widget.Material3.Button.TonalButton.Icon" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:paddingHorizontal="8dp" android:text="Galeri" app:icon="@drawable/ic_image" app:iconGravity="textStart" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnManual" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginHorizontal="4dp" android:text="Manual" />
</LinearLayout>
<com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/nav" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white" app:labelVisibilityMode="labeled" app:menu="@menu/nav" />
</LinearLayout>
